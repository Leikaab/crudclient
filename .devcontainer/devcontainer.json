{
	"name": "Python 3",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {
			"ppa": true,
			"version": "os-provided"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"settings": "./settings.json",
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"github.vscode-github-actions",
				"me-dutour-mathieu.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"tamasfe.even-better-toml",
				"RooVeterinaryInc.roo-cline",
				"ms-azuretools.vscode-containers",
				"bierner.markdown-mermaid"
			]
		}
	},
	"forwardPorts": [
		5051, // forward custom liveserver port for coverage
		6333, // Qdrant HTTP API
		9222  // Chrome DevTools Protocol port for remote debugging
	],

	"portsAttributes": {
		"5051": {
			"label": "Coverage - Live Server",
			"onAutoForward": "notify"
		},
		"6333": {
			"label": "Qdrant HTTP API",
			"onAutoForward": "notify"
		},
		"9222": {
			"label": "Chrome DevTools Protocol",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "chmod +x ./.devcontainer/postCreateCommand.sh; sh -c ./.devcontainer/postCreateCommand.sh",
	"postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}; sudo chmod -R 777 /home/vscode/.vscode-server/data/User/globalStorage",
	"remoteUser": "vscode",
	"remoteEnv": {
		"PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
		"PUPPETEER_CONNECT_TO_BROWSER": "true",
		"PATH": "/workspace/.venv/bin:/home/vscode/.local/bin:/root/.local/bin:/usr/local/bin:/usr/bin:/bin"
	}
}